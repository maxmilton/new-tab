{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@maxmilton/oxlint-config/recommended.json",
    "./node_modules/@maxmilton/oxlint-config/stage1.json",
  ],
  "options": {
    "maxWarnings": 20,
    "reportUnusedDisableDirectives": "error",
    "respectEslintDisableDirectives": false,
    "typeAware": true,
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "warn",
    "perf": "error",
    "style": "warn",
    "restriction": "error",
    "nursery": "warn",
  },
  // https://github.com/oxc-project/javascript-globals/blob/main/src/generated/mod.rs#L213
  "env": {
    "builtin": true,
    "es2026": true, // TODO: es2027 once in oxc.
    "bun": true,
    "commonjs": false,
    "browser": true,
    "webextensions": true,
  },
  "rules": {
    "eslint/id-length": [
      "error",
      {
        "exceptionPatterns": ["^[A-Z]$"], // type names
        "exceptions": ["_" /* UserStorageData keys */, "n", "t", "b", "o", "s"],
      },
    ],
    "typescript/promise-function-async": "off",
    "typescript/strict-boolean-expressions": "off",

    // TODO: Remove when we can fix all the issues.
    "typescript/no-unsafe-type-assertion": "off",

    // TODO: Remove after future oxlint updates.
    "typescript/prefer-readonly-parameter-types": "off", // buggy
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "eslint/prefer-template": "off",
        "node/no-sync": ["error", { "ignores": ["hasStorageSync", "updateSync"] }],
        "promise/prefer-await-to-then": "off", // byte savings
        "typescript/no-confusing-void-expression": "off", // byte savings
        "typescript/prefer-string-starts-ends-with": "off", // byte savings + faster
        "typescript/strict-void-return": "off", // byte savings
        "unicorn/explicit-length-check": "off", // byte savings + faster
        "unicorn/no-array-for-each": "off", // more compact + may be faster for cold code
        "unicorn/no-await-expression-member": "off", // byte savings
      },
    },
    {
      "files": ["apps/*/src/components/**"],
      "rules": {
        "unicorn/filename-case": ["error", { "case": "pascalCase" }],
      },
    },
    {
      "files": ["src/sw.ts"],
      "env": {
        "serviceworker": true,
      },
    },
    {
      "files": ["test/**/*.test.ts", "test/**/*.spec.ts"],
      "rules": {
        "promise/prefer-await-to-callbacks": "off",
        "unicorn/consistent-function-scoping": "off", // tests may define scoped helpers

        // TODO: Remove when we can fix all the issues.
        "eslint/no-warning-comments": "off",
      },
    },
    {
      "files": ["test/unit/**", "test/setup.ts"],
      "env": {
        "node": true,
      },
      "globals": {
        "$console": "readonly",
        "happyDOM": "readonly",
      },
    },
    {
      "files": ["test/e2e/**"],
      "plugins": ["vitest"],
      "rules": {
        "vitest/consistent-test-filename": ["error", { "pattern": ".*\\.spec\\.ts$" }],
      },
    },
  ],
}
