{
  "name": "new-tab",
  "version": "0.24.0-next.0",
  "private": true,
  "description": "⚡ A high-performance new tab page that gets you where you need to go faster.",
  "homepage": "https://github.com/maxmilton/new-tab",
  "bugs": "https://github.com/maxmilton/new-tab/issues",
  "license": "MIT",
  "author": "Max Milton <max@2okki.com>",
  "repository": "github:maxmilton/new-tab",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "NODE_ENV=production bun build.ts",
    "dev": "NODE_ENV=development bun build.ts",
    "lint": "bun lint:fmt && bun lint:fmt2 && bun lint:css && bun lint:js && bun lint:ts",
    "lint:css": "stylelint **.css",
    "lint:fmt": "oxfmt --check",
    "lint:fmt2": "biome check",
    "lint:js": "oxlint",
    "lint:ts": "tsc --noEmit",
    "test": "bun test --only-failures",
    "test:ci": "bun test --coverage --randomize --rerun-each=10",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "stage1": "0.12.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@maxmilton/oxlint-config": "0.0.22",
    "@maxmilton/test-utils": "0.0.18",
    "@playwright/test": "1.64.0",
    "@types/bun": "1.4.3",
    "@types/chrome": "0.3.5",
    "happy-dom": "21.0.1",
    "lightningcss": "1.33.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "terser": "5.51.2",
    "typescript": "7.0.2"
  }
}
